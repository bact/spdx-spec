node398 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>noSupport</B></td></tr><tr><td href='https://spdx.org/rdf/3.1/terms/Core/SupportType/noSupport' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3.1/terms/Core/SupportType/noSupport</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;There is no support for the artifact from the supplier, consumer assumes any support obligations.&quot;@en</td></tr></table> > ] 
