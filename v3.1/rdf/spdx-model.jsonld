        "@value": "Class that describes an InstantiateVirtualHardwareProcess that is used to define VirtualHardware and its source."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://spdx.org/rdf/3/terms/SupplyChain/CreateProcess"
