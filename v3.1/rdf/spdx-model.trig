        sh:nodeKind sh:IRI ;
        sh:property _:N6428044772934dd4adc1b6029707b6ec,
            _:Na73d38ec78f941b9af435647430643ec .

    ns4:OrLaterOperator a owl:Class,
            sh:NodeShape ;
        rdfs:comment """Portion of an AnyLicenseInfo representing this version, or any later version,
of the indicated License."""@en ;
        rdfs:subClassOf ns4:ExtendableLicense ;
        sh:nodeKind sh:IRI ;
        sh:property _:N53a69e2d96f7417d809711a84effbd45 .

    ns4:WithAdditionOperator a owl:Class,
            sh:NodeShape ;
        rdfs:comment """Portion of an AnyLicenseInfo representing a License which has additional
text applied to it."""@en ;
