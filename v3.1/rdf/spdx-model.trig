        ns1:creationInfo <https://spdx.org/rdf/3.0.1/creationInfo_SpdxOrganization> .

    ns8:NoAssertionLicense a owl:NamedIndividual,
            ns8:IndividualLicensingInfo ;
        rdfs:comment """An Individual Value for License when no assertion can be made about its actual
value."""@en ;
        owl:sameAs <https://spdx.org/rdf/3.1/terms/Licensing/NoAssertion> ;
        ns1:creationInfo <https://spdx.org/rdf/3.0.1/creationInfo_NoAssertionLicense> .

    ns8:NoneLicense a owl:NamedIndividual,
            ns8:IndividualLicensingInfo ;
        rdfs:comment """An Individual Value for License where the SPDX data creator determines that no
license is present."""@en ;
        owl:sameAs <https://spdx.org/rdf/3.1/terms/Licensing/None> ;
        ns1:creationInfo <https://spdx.org/rdf/3.0.1/creationInfo_NoneLicense> .

