        sh:property _:N59b65a77dbd2431789e20eaa53d12d9e,
            _:N72a8cf741ada41348aa0eb73c22d11c4 .

    ns4:ListedLicenseException a owl:Class,
            sh:NodeShape ;
        rdfs:comment "A license exception that is listed on the SPDX Exceptions list."@en ;
