    ns8:VexUnderInvestigationVulnAssessmentRelationship a owl:Class ;
        rdfs:comment """Designates elements as products where the impact of a vulnerability is being
investigated."""@en ;
        rdfs:subClassOf ns8:VexVulnAssessmentRelationship ;
        sh:nodeKind sh:IRI .

    ns8:Vulnerability a owl:Class,
            sh:NodeShape ;
        rdfs:comment "Specifies a vulnerability and its associated information."@en ;
        rdfs:subClassOf ns2:Artifact ;
        sh:nodeKind sh:IRI ;
        sh:property _:N621f873001244a73988e0a1977db296e,
