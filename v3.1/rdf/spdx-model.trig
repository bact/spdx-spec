        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:property _:Nb0c2a96775764abfa4fef79ee85eb90c .

    ns2:mass a owl:DatatypeProperty ;
        rdfs:comment "Information related to physical hardware."@en ;
