        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:property _:N372774ce8f044243b4e1860da622d545 .

    ns10:mass a owl:DatatypeProperty ;
        rdfs:comment "Information related to physical hardware."@en ;
