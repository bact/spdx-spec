    spdx: a owl:Ontology ;
        rdfs:label "System Package Data Exchange™ (SPDX®) Ontology"@en ;
        dcterms:abstract "This ontology defines the terms and relationships used in the SPDX specification to describe system packages"@en ;
        dcterms:created "2024-04-05"^^xsd:date ;
        dcterms:creator "SPDX Project"@en ;
        dcterms:license <https://spdx.org/licenses/Community-Spec-1.0.html> ;
        dcterms:references <https://spdx.dev/specifications/> ;
        dcterms:title "System Package Data Exchange (SPDX) Ontology"@en ;
        owl:versionIRI spdx: ;
        omg-ann:copyright "Copyright (C) 2024 SPDX Project"@en .

    ns8:AIPackage a owl:Class,
            sh:NodeShape ;
        rdfs:comment "A Package that contains AI software or an AI model."@en ;
        rdfs:subClassOf ns3:Package ;
        sh:nodeKind sh:IRI ;
        sh:property _:N145e18af823e44418ab804100b55446f,
            _:N33ad6335f08d4f11a4557c2b20ffc08b,
            _:N6251561c610049f59f572ff87a88067b,
            _:N783e9809da254523842d0e5183eb6516,
            _:N7a945ede57d04800af3345f6800d5868,
            _:N95356ea7ebbe413c9a83aa34a95fd137,
            _:N97048eb3dcde4e1fbbd206c1584e785a,
            _:N9b1870ffb16c4726bfe86cf0c3ea5840,
            _:Nb4d2c02e820649b6a72c1ca67c8b730a,
            _:Nb5873b524dd144dab7f9c57075d6907e,
            _:Nbd90d42e4b8b4341ba2c66d9226df57e,
            _:Ncd1b3a25f240481ab299646560433f50,
            _:Nd0591c32d35b4124bae7271c6119dcc3,
            _:Nf1cfcc6950494492b768636d2d4dbaa3,
            _:Nf2624586d92342f591917e34ae1906bb,
            _:Nfecc955efa3d4ca09f7b3be80043ce18 .

    <https://spdx.org/rdf/3.1/terms/AI/EnergyUnitType/kilowattHour> a owl:NamedIndividual,
            ns8:EnergyUnitType ;
        rdfs:label "kilowattHour" ;
        rdfs:comment "Kilowatt-hour."@en .

    <https://spdx.org/rdf/3.1/terms/AI/EnergyUnitType/megajoule> a owl:NamedIndividual,
            ns8:EnergyUnitType ;
        rdfs:label "megajoule" ;
        rdfs:comment "Megajoule."@en .

    <https://spdx.org/rdf/3.1/terms/AI/EnergyUnitType/other> a owl:NamedIndividual,
            ns8:EnergyUnitType ;
        rdfs:label "other" ;
        rdfs:comment "Any other units of energy measurement."@en .

    <https://spdx.org/rdf/3.1/terms/AI/SafetyRiskAssessmentType/high> a owl:NamedIndividual,
            ns8:SafetyRiskAssessmentType ;
        rdfs:label "high" ;
        rdfs:comment "The second-highest level of risk posed by an AI system."@en .

    <https://spdx.org/rdf/3.1/terms/AI/SafetyRiskAssessmentType/low> a owl:NamedIndividual,
            ns8:SafetyRiskAssessmentType ;
        rdfs:label "low" ;
        rdfs:comment "Low/no risk is posed by an AI system."@en .

    <https://spdx.org/rdf/3.1/terms/AI/SafetyRiskAssessmentType/medium> a owl:NamedIndividual,
            ns8:SafetyRiskAssessmentType ;
        rdfs:label "medium" ;
        rdfs:comment "The third-highest level of risk posed by an AI system."@en .

    <https://spdx.org/rdf/3.1/terms/AI/SafetyRiskAssessmentType/serious> a owl:NamedIndividual,
            ns8:SafetyRiskAssessmentType ;
        rdfs:label "serious" ;
        rdfs:comment "The highest level of risk posed by an AI system."@en .

    ns8:autonomyType a owl:ObjectProperty ;
        rdfs:comment """Indicates whether the system can perform a decision or action without human
involvement or guidance.

*Deprecated in SPDX 3.1.*
Use [/Core/isoAutomationLevel](../../Core/Properties/isoAutomationLevel.md)
instead."""@en ;
        rdfs:range ns2:PresenceType .

    ns8:domain a owl:DatatypeProperty ;
        rdfs:comment "Captures the domain in which the AI package can be used."@en ;
        rdfs:range xsd:string .

    ns8:energyConsumption a owl:ObjectProperty ;
        rdfs:comment "Indicates the amount of energy consumption incurred by an AI model."@en ;
        rdfs:range ns8:EnergyConsumption .

    ns8:energyQuantity a owl:DatatypeProperty ;
        rdfs:comment "Represents the energy quantity."@en ;
        rdfs:range xsd:decimal .

    ns8:energyUnit a owl:ObjectProperty ;
        rdfs:comment "Specifies the unit in which energy is measured."@en ;
        rdfs:range ns8:EnergyUnitType .

    ns8:finetuningEnergyConsumption a owl:ObjectProperty ;
        rdfs:comment """Specifies the amount of energy consumed when finetuning the AI model that is
being used in the AI system."""@en ;
        rdfs:range ns8:EnergyConsumptionDescription .

    ns8:hyperparameter a owl:ObjectProperty ;
        rdfs:comment """Records a hyperparameter used to build the AI model contained in the AI
package."""@en ;
        rdfs:range ns2:DictionaryEntry .

    ns8:inferenceEnergyConsumption a owl:ObjectProperty ;
        rdfs:comment """Specifies the amount of energy consumed during inference time by an AI model
that is being used in the AI system."""@en ;
        rdfs:range ns8:EnergyConsumptionDescription .

    ns8:informationAboutApplication a owl:DatatypeProperty ;
        rdfs:comment """Provides relevant information about the AI software, not including the model
description."""@en ;
        rdfs:range xsd:string .

    ns8:informationAboutTraining a owl:DatatypeProperty ;
        rdfs:comment "Describes relevant information about different steps of the training process."@en ;
        rdfs:range xsd:string .

    ns8:limitation a owl:DatatypeProperty ;
        rdfs:comment "Captures a limitation of the AI software."@en ;
        rdfs:range xsd:string .

    ns8:metric a owl:ObjectProperty ;
        rdfs:comment "Records the measurement of prediction quality of the AI model."@en ;
        rdfs:range ns2:DictionaryEntry .

    ns8:metricDecisionThreshold a owl:ObjectProperty ;
        rdfs:comment """Captures the threshold that was used for computation of a metric described in
the metric field."""@en ;
        rdfs:range ns2:DictionaryEntry .

    ns8:modelDataPreprocessing a owl:DatatypeProperty ;
        rdfs:comment """Describes all the preprocessing steps applied to the training data before the
model training."""@en ;
        rdfs:range xsd:string .

    ns8:modelExplainability a owl:DatatypeProperty ;
        rdfs:comment "Describes methods that can be used to explain the results from the AI model."@en ;
        rdfs:range xsd:string .

    ns8:safetyRiskAssessment a owl:ObjectProperty ;
        rdfs:comment "Records the results of general safety risk assessment of the AI system."@en ;
        rdfs:range ns8:SafetyRiskAssessmentType .

    ns8:standardCompliance a owl:DatatypeProperty ;
        rdfs:comment "Captures a standard that an artifact is being complied with."@en ;
        rdfs:range xsd:string .

    ns8:trainingEnergyConsumption a owl:ObjectProperty ;
        rdfs:comment """Specifies the amount of energy consumed when training the AI model that is
being used in the AI system."""@en ;
        rdfs:range ns8:EnergyConsumptionDescription .

    ns8:typeOfModel a owl:DatatypeProperty ;
        rdfs:comment "Records the type of the model used in the AI software."@en ;
        rdfs:range xsd:string .

    ns8:useSensitivePersonalInformation a owl:ObjectProperty ;
        rdfs:comment """Records if sensitive personal information is used during model training or
could be used during the inference."""@en ;
        rdfs:range ns2:PresenceType .

    <https://spdx.org/rdf/3.1/terms/Build/Build> a owl:Class,
            sh:NodeShape ;
        rdfs:comment "Class that describes a build instance of software/artifacts."@en ;
