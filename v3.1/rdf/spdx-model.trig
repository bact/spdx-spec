            _:Nf8e8117550b64a0fbc37edd2e17e76f9 .

    ns3:SoftwareAgent a owl:Class ;
        rdfs:comment "A software agent."@en ;
        rdfs:subClassOf ns3:Agent ;
        sh:nodeKind sh:IRI .

    ns3:SpdxDocument a owl:Class,
            sh:NodeShape ;
        rdfs:comment "A collection of SPDX Elements that could potentially be serialized."@en ;
