  {
    "@id": "_:Na14cb5155afb41e2b61bc8d0ce31bea6",
    "@type": [
      "http://www.w3.org/ns/shacl#SPARQLConstraint"
    ],
    "http://www.w3.org/ns/shacl#message": [
      {
        "@value": "When relationship is tracedToDetail, from must be a Requirement"
      }
    ],
    "http://www.w3.org/ns/shacl#select": [
      {
        "@value": "BASE <https://spdx.org/rdf/3/terms/>\nSELECT $this WHERE {\n    $this <Core/relationshipType> <Core/RelationshipType/tracedToDetail> .\n    $this <Core/from> ?from .\n    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* <Core/Requirement> }\n}"
      }
    ]
  },
  {
    "@id": "_:N45c022bbe1704ec1afada46991d2d287",
    "@type": [
      "http://www.w3.org/ns/shacl#SPARQLConstraint"
    ],
    "http://www.w3.org/ns/shacl#message": [
      {
        "@value": "When relationship is tracedToDetail, to must be a Requirement"
      }
    ],
    "http://www.w3.org/ns/shacl#select": [
      {
        "@value": "BASE <https://spdx.org/rdf/3/terms/>\nSELECT $this WHERE {\n    $this <Core/relationshipType> <Core/RelationshipType/tracedToDetail> .\n    $this <Core/to> ?to .\n    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* <Core/Requirement> }\n}"
      }
    ]
  },
  {
    "@id": "_:N927f113d8c6947de9cf06ef3cb2b25ad",
    "@type": [
      "http://www.w3.org/ns/shacl#SPARQLConstraint"
    ],
    "http://www.w3.org/ns/shacl#message": [
      {
        "@value": "When relationship is underInvestigationFor, from must be a Vulnerability"
      }
    ],
    "http://www.w3.org/ns/shacl#select": [
      {
        "@value": "BASE <https://spdx.org/rdf/3/terms/>\nSELECT $this WHERE {\n    $this <Core/relationshipType> <Core/RelationshipType/underInvestigationFor> .\n    $this <Core/from> ?from .\n    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* <Security/Vulnerability> }\n}"
      }
    ]
  },
  {
    "@id": "_:Nfe74923b1a8b4e0b886a2be7bf01852f",
    "@type": [
      "http://www.w3.org/ns/shacl#SPARQLConstraint"
    ],
    "http://www.w3.org/ns/shacl#message": [
      {
        "@value": "When relationship is underInvestigationFor, class must be VexUnderInvestigationVulnAssessmentRelationship"
      }
    ],
    "http://www.w3.org/ns/shacl#select": [
      {
        "@value": "BASE <https://spdx.org/rdf/3/terms/>\nSELECT $this WHERE {\n    $this <Core/relationshipType> <Core/RelationshipType/underInvestigationFor> .\n    FILTER NOT EXISTS { $this rdf:type <Security/VexUnderInvestigationVulnAssessmentRelationship> }\n}"
      }
    ]
  },
  {
    "@id": "_:Nbe358644ea874c42b71d1d24392665f3",
    "@type": [
      "http://www.w3.org/ns/shacl#SPARQLConstraint"
    ],
    "http://www.w3.org/ns/shacl#message": [
      {
        "@value": "When relationship is usesTool, class must be LifecycleScopedRelationship"
      }
    ],
    "http://www.w3.org/ns/shacl#select": [
      {
        "@value": "BASE <https://spdx.org/rdf/3/terms/>\nSELECT $this WHERE {\n    $this <Core/relationshipType> <Core/RelationshipType/usesTool> .\n    FILTER NOT EXISTS { $this rdf:type <Core/LifecycleScopedRelationship> }\n}"
      }
    ]
  },
  {
    "@id": "_:N63fc3252d8af4f16b0294e2a0524d2af",
    "@type": [
      "http://www.w3.org/ns/shacl#SPARQLConstraint"
    ],
    "http://www.w3.org/ns/shacl#message": [
      {
        "@value": "When relationship is verifiedBy, from must be a Requirement"
      }
    ],
    "http://www.w3.org/ns/shacl#select": [
      {
        "@value": "BASE <https://spdx.org/rdf/3/terms/>\nSELECT $this WHERE {\n    $this <Core/relationshipType> <Core/RelationshipType/verifiedBy> .\n    $this <Core/from> ?from .\n    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* <Core/Requirement> }\n}"
      }
    ]
  },
  {
    "@id": "_:N80a5416e295b4fafa5d37eb96b4dea2b",
    "@type": [
