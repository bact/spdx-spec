    _:N0027b0f8127740ceae557d1b5a2fd11c a sh:SPARQLConstraint ;
        sh:message "When relationship is implementedBy, from must be a Requirement" ;
        sh:select """BASE <https://spdx.org/rdf/3/terms/>
SELECT $this WHERE {
    $this <Core/relationshipType> <Core/RelationshipType/implementedBy> .
    $this <Core/from> ?from .
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* <Core/Requirement> }
}""" .

