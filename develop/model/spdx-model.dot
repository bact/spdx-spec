node552 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N420024ce72bf4976a933c42775d12fe4</B></td></tr><tr><td href='N420024ce72bf4976a933c42775d12fe4' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N420024ce72bf4976a933c42775d12fe4</font></td></tr></table> > ] 
