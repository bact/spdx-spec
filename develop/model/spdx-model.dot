node824 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>graph</B></td></tr><tr><td href='https://spdx.org/rdf/3.1/terms/Dataset/DatasetType/graph' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3.1/terms/Dataset/DatasetType/graph</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;Data is in the form of a graph where entries are somehow related to each other through edges, such a social network of friends.&quot;@en</td></tr></table> > ] 
