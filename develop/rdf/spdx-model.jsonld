  {
    "@id": "https://spdx.org/rdf/3.1/terms/Software/SoftwarePurpose/evidence",
    "@type": [
      "http://www.w3.org/2002/07/owl#NamedIndividual",
      "https://spdx.org/rdf/3.1/terms/Software/SoftwarePurpose"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The Element is the evidence that a specification or requirement has been fulfilled."
      }
