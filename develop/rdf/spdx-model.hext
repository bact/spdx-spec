["_:N45c022bbe1704ec1afada46991d2d287", "http://www.w3.org/ns/shacl#select", "BASE <https://spdx.org/rdf/3/terms/>\nSELECT $this WHERE {\n    $this <Core/relationshipType> <Core/RelationshipType/tracedToDetail> .\n    $this <Core/to> ?to .\n    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* <Core/Requirement> }\n}", "http://www.w3.org/2001/XMLSchema#string", "", ""]
