        sh:nodeKind sh:IRI .

    ns2:Vulnerability a owl:Class,
            sh:NodeShape ;
        rdfs:comment "Specifies a vulnerability and its associated information."@en ;
        rdfs:subClassOf ns1:Artifact ;
        sh:nodeKind sh:IRI ;
        sh:property _:N8145fec9a6fe473db7d482ccc5b94770,
