            _:Nea90e9d3cd024f7ca3b6ed4e8274b935 .

    ns2:SoftwareAgent a owl:Class ;
        rdfs:comment "A software agent."@en ;
        rdfs:subClassOf ns2:Agent ;
        sh:nodeKind sh:IRI .

    ns2:SpdxDocument a owl:Class,
            sh:NodeShape ;
