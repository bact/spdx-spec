        sh:property _:Nca595a5aa07242a990ae7697d1b1a145,
            _:Ndfc31963152c4406b1e106f1f145b6d5 .

    ns5:ListedLicenseException a owl:Class,
            sh:NodeShape ;
        rdfs:comment "A license exception that is listed on the SPDX Exceptions list."@en ;
