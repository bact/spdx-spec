        sh:nodeKind sh:IRI ;
        sh:property _:N060b2e4d07dd4053aaa36316cf06473f,
            _:N3e0ab95456434414b3bcefe3f626da20,
            _:N686d15ad7aa445fea53e90a0f4d8d28c,
