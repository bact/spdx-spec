        rdfs:comment "When a CVSS score is between 9.0 - 10.0."@en .

    <https://spdx.org/rdf/3.1/terms/Security/CvssSeverityType/high> a owl:NamedIndividual,
            ns5:CvssSeverityType ;
        rdfs:label "high" ;
