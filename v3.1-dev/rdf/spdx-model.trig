        sh:nodeKind sh:IRI ;
        sh:property _:N21e1f86c69784c7294f6279ad0b388ff,
            _:N3f7a75cc035d4342acdb29b82d13605a,
            _:N404e1a93163542d59e6cc708d577d6c5,
            _:N5d8bdda3d2144159892008da9b5d20a9,
            _:N8f92206efa1e4946a9daecc2e8c8c6ce,
            _:Naae92ab7f37e4ff28fc54c33954e57d2,
            _:Nad36c14b18e44178b415b9ffd7527cda,
            _:Nb394b3d97f424b2b8889f34212ad9598,
            _:Nfd44cec464e74151b782a9704a49b742 .

    <https://spdx.org/rdf/3/terms/Core/ProcessReadinessType/active> a owl:NamedIndividual,
