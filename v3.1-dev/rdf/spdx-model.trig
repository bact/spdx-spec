        sh:nodeKind sh:IRI ;
        sh:property _:N12242e544fdc484a98f1271800dbe73a,
            _:N149bc9f931e047e9918ee08a41b0a94b,
            _:N5999791cf97a411b9baa4c54c047efc7,
