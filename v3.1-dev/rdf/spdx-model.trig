    <https://spdx.org/rdf/3.1/terms/SimpleLicensing/customIdToUri> a owl:ObjectProperty ;
        rdfs:comment """**DEPRECATED**

Maps a LicenseRef or AdditionRef string for a Custom License or a Custom
License Addition to its URI ID."""@en ;
        rdfs:range ns2:DictionaryEntry .

