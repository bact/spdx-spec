            _:N9c1b1a8aad0c4492a44f43402b5548f8,
            _:Nd3f90c0bac7e4a25a5afeba8ac65e9ae .

    ns6:SoftwareAgent a owl:Class ;
        rdfs:comment "A software agent."@en ;
        rdfs:subClassOf ns6:Agent ;
        sh:nodeKind sh:IRI .

    ns6:SpdxDocument a owl:Class,
            sh:NodeShape ;
        rdfs:comment "A collection of SPDX Elements that could potentially be serialized."@en ;
        rdfs:subClassOf ns6:ElementCollection ;
        sh:nodeKind sh:IRI ;
