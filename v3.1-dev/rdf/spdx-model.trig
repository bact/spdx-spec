        rdfs:range ns5:CvssSeverityType .

    ns5:withdrawnTime a owl:DatatypeProperty ;
        rdfs:comment "Specified the time and date when a vulnerability was withdrawn."@en ;
        rdfs:range xsd:dateTimeStamp .

