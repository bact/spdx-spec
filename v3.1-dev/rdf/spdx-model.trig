    ns9:VexUnderInvestigationVulnAssessmentRelationship a owl:Class ;
        rdfs:comment """Designates elements as products where the impact of a vulnerability is being
investigated."""@en ;
        rdfs:subClassOf ns9:VexVulnAssessmentRelationship ;
        sh:nodeKind sh:IRI .

    ns9:Vulnerability a owl:Class,
            sh:NodeShape ;
        rdfs:comment "Specifies a vulnerability and its associated information."@en ;
        rdfs:subClassOf ns3:Artifact ;
        sh:nodeKind sh:IRI ;
        sh:property _:N7f510f209d194bd8807738c754987ff7,
