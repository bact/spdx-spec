only one of the elements applies."""@en ;
        rdfs:subClassOf <https://spdx.org/rdf/3.1/terms/SimpleLicensing/AnyLicenseInfo> ;
        sh:nodeKind sh:IRI ;
        sh:property _:N9923d3683c5d40c7996489acc786eab3 .

