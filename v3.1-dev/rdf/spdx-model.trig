        rdfs:comment """Size of the dataset.

*Deprecated in SPDX 3.1.*
Use [/Software/artifactSize](../../Software/Properties/artifactSize.md) instead."""@en ;
        rdfs:range xsd:nonNegativeInteger .

    ns9:datasetType a owl:ObjectProperty ;
        rdfs:comment "Type of data in a dataset."@en ;
        rdfs:range ns9:DatasetType .

    ns9:datasetUpdateMechanism a owl:DatatypeProperty ;
        rdfs:comment "Mechanism to update the dataset."@en ;
        rdfs:range xsd:string .

    ns9:hasSensitivePersonalInformation a owl:ObjectProperty ;
        rdfs:comment "Describes if any sensitive personal information is present in the dataset."@en ;
        rdfs:range ns4:PresenceType .

    ns9:intendedUse a owl:DatatypeProperty ;
        rdfs:comment """The intended use of a given dataset.

*Deprecated in SPDX 3.1.*
Use [/Core/intendedUse](../../Core/Properties/intendedUse.md) instead."""@en ;
        rdfs:range xsd:string .

    ns9:knownBias a owl:DatatypeProperty ;
        rdfs:comment "Records the biases that the dataset is known to encompass."@en ;
        rdfs:range xsd:string .

    ns9:sensor a owl:ObjectProperty ;
        rdfs:comment "Describes a sensor used for collecting the data."@en ;
        rdfs:range ns4:DictionaryEntry .

    ns10:ConjunctiveLicenseSet a owl:Class,
            sh:NodeShape ;
