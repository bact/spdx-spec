    ns7:plannedStorageLocation a owl:ObjectProperty ;
        rdfs:comment "The planned location that a good, product or material is stored."@en ;
        rdfs:range ns4:Location .

    ns7:plannedTransportRoutes a owl:DatatypeProperty ;
