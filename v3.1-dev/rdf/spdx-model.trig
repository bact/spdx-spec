        rdfs:range ns3:Element .

    ns11:plannedStorageLocation a owl:ObjectProperty ;
        rdfs:comment "The planned location that a good, product or material is stored."@en ;
        rdfs:range ns3:Location .

    ns11:plannedTransportRoutes a owl:DatatypeProperty ;
