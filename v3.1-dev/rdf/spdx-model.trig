        rdfs:subClassOf ns11:ModifyAction ;
        sh:nodeKind sh:IRI .

    ns11:ChangeProcess a owl:Class ;
        rdfs:comment "A prescribed change to a product."@en ;
        rdfs:subClassOf ns11:ModifyProcess ;
        sh:nodeKind sh:IRI .

    ns11:DestroyAction a owl:Class,
