        "@language": "en",
        "@value": "The intended use of a given dataset.\n\n*Deprecated in SPDX 3.1.*\nUse [/Core/intendedUse](../../Core/Properties/intendedUse.md) instead."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
