["_:Na1dffa3bfef64dc8ba64168e538835de", "http://www.w3.org/ns/shacl#select", "BASE <https://spdx.org/rdf/3/terms/>\nSELECT $this WHERE {\n    $this <Core/relationshipType> <Core/RelationshipType/fixedBy> .\n    $this <Core/from> ?from .\n    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* <Security/Vulnerability> }\n}", "http://www.w3.org/2001/XMLSchema#string", "", ""]
["https://spdx.org/rdf/3/terms/Core/HashAlgorithm/blake3", "http://www.w3.org/2000/01/rdf-schema#label", "blake3", "http://www.w3.org/2001/XMLSchema#string", "", ""]
["https://spdx.org/rdf/3/terms/FunctionalSafety/VerificationType/inspection", "http://www.w3.org/2000/01/rdf-schema#comment", "A thorough examination or checking of documentation, records, processes, or systems to confirm compliance or adherence. An inspection needs to have a defined set of acceptance criteria (e.g. a checklist), a documentation of roles involved in the inspection (e.g. to document the inspector's independence) and a clear documentation of when and how it was performed.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/isbn", "http://www.w3.org/2000/01/rdf-schema#comment", "[International Standard Book Number (ISBN)](https://www.isbn-international.org/content/isbn-users-manual/29) is a unique numeric identifier for monographic publications standardized by [ISO 2108](https://www.iso.org/standard/65483.html). It consists of either 10 digits (for assignments prior to January 1, 2007) or 13 digits. A 13-digit ISBN is composed of five parts: a GS1 prefix, a registration group, a registrant, a publication element, and a check digit. While elements may be divided by spaces or hyphens for human readability, these separators shall be omitted when the identifier is stored electronically (e.g., `9780198836063`).", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/Core/key", "http://www.w3.org/2000/01/rdf-schema#comment", "A key used in a generic key-value pair.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/AI/energyUnit", "http://www.w3.org/2000/01/rdf-schema#range", "https://spdx.org/rdf/3/terms/AI/EnergyUnitType", "globalId", "", ""]
["https://spdx.org/rdf/3/terms/SupplyChain/ModifyAction", "http://www.w3.org/ns/shacl#nodeKind", "http://www.w3.org/ns/shacl#IRI", "globalId", "", ""]
["_:N12dfe1e11c1b4db984b9960237830760", "http://www.w3.org/ns/shacl#select", "BASE <https://spdx.org/rdf/3/terms/>\nSELECT $this WHERE {\n    $this <Core/relationshipType> <Core/RelationshipType/hasResolution> .\n    $this <Core/to> ?to .\n    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* <SupplyChain/OutOfSpecAction> }\n}", "http://www.w3.org/2001/XMLSchema#string", "", ""]
