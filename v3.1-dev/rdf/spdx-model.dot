node984 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N58c7c035202148958541cc0a31f2d1c8</B></td></tr><tr><td href='N58c7c035202148958541cc0a31f2d1c8' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N58c7c035202148958541cc0a31f2d1c8</font></td></tr></table> > ] 
