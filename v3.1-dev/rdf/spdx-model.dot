node794 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Ne39ffb79ccf745f8ab72bc8c31f03ae7</B></td></tr><tr><td href='Ne39ffb79ccf745f8ab72bc8c31f03ae7' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Ne39ffb79ccf745f8ab72bc8c31f03ae7</font></td></tr></table> > ] 
