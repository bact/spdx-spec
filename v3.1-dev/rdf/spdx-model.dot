node1979 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Nf1e17fc6ab834e62bc31d3f1e789b9cf</B></td></tr><tr><td href='Nf1e17fc6ab834e62bc31d3f1e789b9cf' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Nf1e17fc6ab834e62bc31d3f1e789b9cf</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is providesSupportFor, class must be SupportRelationship&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
