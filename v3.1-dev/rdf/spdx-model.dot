node981 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>hazard</B></td></tr><tr><td href='https://spdx.org/rdf/3.1/terms/Hardware/hazard' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3.1/terms/Hardware/hazard</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;Hazards are potential sources of harm, danger, or adverse effects to people, property, the environment, or systems within or related to a specific piece of hardware.&quot;@en</td></tr></table> > ] 
