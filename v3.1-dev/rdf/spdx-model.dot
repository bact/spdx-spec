# N8fc14b4edfdf43788ea9b2f3551edd51 node1150
node1150 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N8fc14b4edfdf43788ea9b2f3551edd51</B></td></tr><tr><td href='N8fc14b4edfdf43788ea9b2f3551edd51' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N8fc14b4edfdf43788ea9b2f3551edd51</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is hasContactPoint, to must be an Agent&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/hasContactPoint&gt; .
    $this &lt;Core/to&gt; ?to .
    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* &lt;Core/Agent&gt; }
}&quot;</td></tr></table> > ] 
