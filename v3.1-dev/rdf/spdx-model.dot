# https://spdx.org/rdf/3.1/terms/Core/ExternalIdentifierType/evidenceUUID node1
node1 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>evidenceUUID</B></td></tr><tr><td href='https://spdx.org/rdf/3.1/terms/Core/ExternalIdentifierType/evidenceUUID' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3.1/terms/Core/ExternalIdentifierType/evidenceUUID</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;The UUID used by a reporting management system or any other lifecycle management tool to uniquely identify an evidence relationship item. UUID, or universally unique ID, is a standard term to refer to evidence items.&quot;@en</td></tr></table> > ] 
# https://spdx.org/rdf/3.1/terms/Core/SupportType/deployed node2
