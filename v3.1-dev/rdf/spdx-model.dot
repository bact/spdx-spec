node1299 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>phoneNumber</B></td></tr><tr><td href='https://spdx.org/rdf/3.1/terms/Core/ExternalIdentifierType/phoneNumber' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3.1/terms/Core/ExternalIdentifierType/phoneNumber</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;Phone number; A string of decimal digits that uniquely indicates the network termination point defined in [RFC 3966](https://datatracker.ietf.org/doc/rfc3966/) Section 5.&quot;@en</td></tr></table> > ] 
