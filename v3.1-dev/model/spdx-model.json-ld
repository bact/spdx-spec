    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Indicates whether the system can perform a decision or action without human\ninvolvement or guidance.\n\n*Deprecated in SPDX 3.1.*\nUse [/Core/isoAutomationLevel](../../Core/Properties/isoAutomationLevel.md)\ninstead."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://spdx.org/rdf/3.1/terms/Core/PresenceType"
      }
    ]
  },
