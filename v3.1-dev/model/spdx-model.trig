        rdfs:comment "A license expression participating in a license set."@en ;
        rdfs:range <https://spdx.org/rdf/3.1/terms/SimpleLicensing/AnyLicenseInfo> .

    ns3:obsoletedBy a owl:DatatypeProperty ;
