        ns1:creationInfo <https://spdx.org/rdf/3.0.1/creationInfo_NoAssertionElement> .

    ns4:NoneElement a owl:NamedIndividual,
            ns4:IndividualElement ;
        rdfs:comment """An Individual Value for Element representing a set of Elements with
cardinality (number/count) of zero."""@en ;
        ns1:creationInfo <https://spdx.org/rdf/3.0.1/creationInfo_NoneElement> .

    ns4:SpdxOrganization a owl:NamedIndividual,
