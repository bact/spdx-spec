            ns2:ExternalRefType ;
        rdfs:label "releaseNotes" ;
        rdfs:comment "A reference to the release notes for a package."@en .

    <https://spdx.org/rdf/3.1/terms/Core/ExternalRefType/riskAssessment> a owl:NamedIndividual,
