        sh:property _:Nc02bda9f201a4ef4817ab4a19e3d432d .

    ns11:InstantiateVirtualHardwareProcess a owl:Class ;
        rdfs:comment "Class that describes an InstantiateVirtualHardwareProcess that is used to define VirtualHardware and its source."@en ;
        rdfs:subClassOf ns11:CreateProcess ;
