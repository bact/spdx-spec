    _:Nd33b5babefb9424fa37ec679d761c6da a sh:SPARQLConstraint ;
        sh:message "When relationship is hasDeclaredLicense, to must be an AnyLicenseInfo" ;
        sh:select """BASE <https://spdx.org/rdf/3/terms/>
SELECT $this WHERE {
    $this <Core/relationshipType> <Core/RelationshipType/hasDeclaredLicense> .
    $this <Core/to> ?to .
    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* <SimpleLicensing/AnyLicenseInfo> }
}""" .

    _:Nd3420214eb2d408eb5451a02469b79fe a sh:SPARQLConstraint ;
        sh:message "A value for Core/name is required when a value for Core/version is present" ;
        sh:select """BASE <https://spdx.org/rdf/3/terms/>
SELECT $this WHERE {
    $this <Software/version> ?version .
    FILTER NOT EXISTS {
        $this <Software/name> ?name .
    }
}""" .

