        ns1:created "2024-11-22T03:00:01Z"^^xsd:dateTimeStamp ;
        ns1:createdBy ns1:SpdxOrganization ;
        ns1:specVersion "3.0.1" .

    spdx: a owl:Ontology ;
        rdfs:label "System Package Data Exchange™ (SPDX®) Ontology"@en ;
        dcterms:abstract "This ontology defines the terms and relationships used in the SPDX specification to describe system packages"@en ;
        dcterms:created "2024-04-05"^^xsd:date ;
        dcterms:creator "SPDX Project"@en ;
        dcterms:license <https://spdx.org/licenses/Community-Spec-1.0.html> ;
        dcterms:references <https://spdx.dev/specifications/> ;
        dcterms:title "System Package Data Exchange (SPDX) Ontology"@en ;
        owl:versionIRI spdx: ;
        omg-ann:copyright "Copyright (C) 2024 SPDX Project"@en .

    ns11:AIPackage a owl:Class,
            sh:NodeShape ;
        rdfs:comment "A Package that contains AI software or an AI model."@en ;
        rdfs:subClassOf ns5:Package ;
        sh:nodeKind sh:IRI ;
        sh:property _:N06c97985d7b640aea04caa773b26936c,
            _:N0ba98b1191c840dea478adafbe18ab09,
            _:N1267ca368eee4b3da81b7c96754c4d3b,
            _:N1b4cdd1c785e4d309544facc54d276ac,
            _:N1fce1cffd5d540e8bbf73505a57d1f70,
            _:N307fe124dbd240e483680cea9c1f301f,
            _:N51f834227c7240a28da524689f271d04,
            _:N6da9e7f3f9e74f948aa53191f67325b9,
            _:N86033e1586ac40a0bca42debb5b35b39,
            _:Na67892c2b4344fd8a8b711c90793ebcb,
            _:Nb2ec164089b34ba782398678a9501417,
            _:Nbd9c7f79f09a47e68815d59c9e9f095e,
            _:Nc472126ea8254ac4b1269c42bd981e63,
            _:Ne433df14b2e542d98b86a31ce0dcd182,
            _:Nee1d899b5ee74f24a7db951b1254009a,
            _:Nfcb692d6e5a14b1f90ace6ea87ce465a .

    <https://spdx.org/rdf/3.1/terms/AI/EnergyUnitType/kilowattHour> a owl:NamedIndividual,
            ns11:EnergyUnitType ;
        rdfs:label "kilowattHour" ;
        rdfs:comment "Kilowatt-hour."@en .

    <https://spdx.org/rdf/3.1/terms/AI/EnergyUnitType/megajoule> a owl:NamedIndividual,
            ns11:EnergyUnitType ;
        rdfs:label "megajoule" ;
        rdfs:comment "Megajoule."@en .

    <https://spdx.org/rdf/3.1/terms/AI/EnergyUnitType/other> a owl:NamedIndividual,
            ns11:EnergyUnitType ;
        rdfs:label "other" ;
        rdfs:comment "Any other units of energy measurement."@en .

    <https://spdx.org/rdf/3.1/terms/AI/SafetyRiskAssessmentType/high> a owl:NamedIndividual,
            ns11:SafetyRiskAssessmentType ;
        rdfs:label "high" ;
        rdfs:comment "The second-highest level of risk posed by an AI system."@en .

    <https://spdx.org/rdf/3.1/terms/AI/SafetyRiskAssessmentType/low> a owl:NamedIndividual,
            ns11:SafetyRiskAssessmentType ;
        rdfs:label "low" ;
        rdfs:comment "Low/no risk is posed by an AI system."@en .

    <https://spdx.org/rdf/3.1/terms/AI/SafetyRiskAssessmentType/medium> a owl:NamedIndividual,
            ns11:SafetyRiskAssessmentType ;
        rdfs:label "medium" ;
        rdfs:comment "The third-highest level of risk posed by an AI system."@en .

    <https://spdx.org/rdf/3.1/terms/AI/SafetyRiskAssessmentType/serious> a owl:NamedIndividual,
            ns11:SafetyRiskAssessmentType ;
        rdfs:label "serious" ;
        rdfs:comment "The highest level of risk posed by an AI system."@en .

    ns11:autonomyType a owl:ObjectProperty ;
        rdfs:comment """Indicates whether the system can perform a decision or action without human
involvement or guidance.

*Deprecated in SPDX 3.1.*
Use [/Core/isoAutomationLevel](../../Core/Properties/isoAutomationLevel.md)
instead."""@en ;
        rdfs:range ns6:PresenceType .

    ns11:domain a owl:DatatypeProperty ;
        rdfs:comment "Domain in which the AI package can be used."@en ;
        rdfs:range xsd:string .

    ns11:energyConsumption a owl:ObjectProperty ;
        rdfs:comment "Energy consumption incurred by an AI model."@en ;
        rdfs:range ns11:EnergyConsumption .

    ns11:energyQuantity a owl:DatatypeProperty ;
        rdfs:comment "Energy quantity."@en ;
        rdfs:range xsd:decimal .

    ns11:energyUnit a owl:ObjectProperty ;
        rdfs:comment "Unit in which energy is measured."@en ;
        rdfs:range ns11:EnergyUnitType .

    ns11:finetuningEnergyConsumption a owl:ObjectProperty ;
        rdfs:comment """Energy consumed when finetuning the AI model that is
being used in the AI system."""@en ;
        rdfs:range ns11:EnergyConsumptionDescription .

    ns11:hyperparameter a owl:ObjectProperty ;
        rdfs:comment "Hyperparameter used to build the AI model contained in the AI package."@en ;
        rdfs:range ns6:DictionaryEntry .

    ns11:inferenceEnergyConsumption a owl:ObjectProperty ;
        rdfs:comment """Energy consumed during inference time by an AI model
that is being used in the AI system."""@en ;
        rdfs:range ns11:EnergyConsumptionDescription .

    ns11:informationAboutApplication a owl:DatatypeProperty ;
        rdfs:comment "Information about the AI software, not including the model description."@en ;
        rdfs:range xsd:string .

    ns11:informationAboutTraining a owl:DatatypeProperty ;
        rdfs:comment "Information about different steps of the training process."@en ;
        rdfs:range xsd:string .

    ns11:limitation a owl:DatatypeProperty ;
        rdfs:comment "Limitation of the AI software."@en ;
        rdfs:range xsd:string .

    ns11:metric a owl:ObjectProperty ;
        rdfs:comment "Metric used to evaluate the AI model."@en ;
        rdfs:range ns6:DictionaryEntry .

    ns11:metricDecisionThreshold a owl:ObjectProperty ;
        rdfs:comment """Threshold that was used for computation of a metric described in
the metric field."""@en ;
        rdfs:range ns6:DictionaryEntry .

    ns11:modelDataPreprocessing a owl:DatatypeProperty ;
        rdfs:comment "Preprocessing steps applied to the training data before the model training."@en ;
        rdfs:range xsd:string .

    ns11:modelExplainability a owl:DatatypeProperty ;
        rdfs:comment "Methods that can be used to explain the results from the AI model."@en ;
        rdfs:range xsd:string .

    ns11:safetyRiskAssessment a owl:ObjectProperty ;
        rdfs:comment "Results of general safety risk assessment of the AI system."@en ;
        rdfs:range ns11:SafetyRiskAssessmentType .

    ns11:standardCompliance a owl:DatatypeProperty ;
        rdfs:comment "Standard that an artifact is being complied with."@en ;
        rdfs:range xsd:string .

    ns11:trainingEnergyConsumption a owl:ObjectProperty ;
        rdfs:comment """Energy consumed when training the AI model that is
being used in the AI system."""@en ;
        rdfs:range ns11:EnergyConsumptionDescription .

    ns11:typeOfModel a owl:DatatypeProperty ;
        rdfs:comment "Type of the model used in the AI software."@en ;
        rdfs:range xsd:string .

    ns11:useSensitivePersonalInformation a owl:ObjectProperty ;
        rdfs:comment """Records if sensitive personal information is used during model training or
could be used during the inference."""@en ;
        rdfs:range ns6:PresenceType .

    <https://spdx.org/rdf/3.1/terms/Build/Build> a owl:Class,
            sh:NodeShape ;
        rdfs:comment "Class that describes a build instance of software/artifacts."@en ;
        rdfs:subClassOf ns6:Element ;
        sh:nodeKind sh:IRI ;
        sh:property _:N21c860dfe84d4a359048b328a27a5065,
            _:N27b2963839da44f091d0cfd6809d0f75,
            _:N4bb8281a5ea446398e78de78a83fae2a,
