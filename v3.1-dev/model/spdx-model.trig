            sh:NodeShape ;
        rdfs:comment "A Package that contains a dataset."@en ;
        rdfs:subClassOf ns8:Package ;
        sh:nodeKind sh:IRI ;
        sh:property _:N0d50d91bee754d05a96b14b8fa6326e8,
