        rdfs:subClassOf ns11:CreateProcess ;
        sh:nodeKind sh:IRI .

    ns11:ResolutionAction a owl:Class ;
        rdfs:comment "Products out of specification require a resolution action. This is the action of resolution."@en ;
        rdfs:subClassOf ns11:UseAction ;
        sh:nodeKind sh:IRI .

    ns11:ResponsibilityChangeAction a owl:Class,
