        rdfs:range ns2:Location .

    ns8:forDropoffLocation a owl:ObjectProperty ;
        rdfs:comment "The location that an item will be dropping off or delivered."@en ;
        rdfs:range ns2:Location .

    ns8:forPickupLocation a owl:ObjectProperty ;
        rdfs:comment "The location for picking up a package or item."@en ;
        rdfs:range ns2:Location .

    ns8:pickupLocation a owl:ObjectProperty ;
        rdfs:comment "The location for picking up a package or item."@en ;
        rdfs:range ns2:Location .

