        sh:nodeKind sh:IRI ;
        sh:property _:Nfa55f01d828048b1aea95de6ef841080 .

    <https://spdx.org/rdf/3.1/terms/Core/ContactPointRelationshipType/compliance> a owl:NamedIndividual,
