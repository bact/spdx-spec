        sh:nodeKind sh:IRI ;
        sh:property _:N3962c578f7614d5a8b5a568ae2fb5efc,
            _:N6fde90f054674f8997e83c102bc67d25 .

    ns4:additionText a owl:DatatypeProperty ;
        rdfs:comment "Identifies the full text of a LicenseAddition."@en ;
        rdfs:range xsd:string .

