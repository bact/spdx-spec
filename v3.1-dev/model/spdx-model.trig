    ns11:datasetType a owl:ObjectProperty ;
        rdfs:comment "Type of data in a dataset."@en ;
        rdfs:range ns11:DatasetType .

    ns11:datasetUpdateMechanism a owl:DatatypeProperty ;
        rdfs:comment "Mechanism to update the dataset."@en ;
        rdfs:range xsd:string .

    ns11:hasSensitivePersonalInformation a owl:ObjectProperty ;
