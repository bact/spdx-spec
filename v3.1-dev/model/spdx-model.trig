        rdfs:range ns10:ConfidentialityLevelType .

    ns10:dataCollectionProcess a owl:DatatypeProperty ;
        rdfs:comment "How the dataset was collected."@en ;
        rdfs:range xsd:string .

    ns10:dataPreprocessing a owl:DatatypeProperty ;
        rdfs:comment "Preprocessing steps that were applied to the raw data to create the given dataset."@en ;
        rdfs:range xsd:string .

    ns10:datasetAvailability a owl:ObjectProperty ;
        rdfs:comment "Availability of a dataset."@en ;
        rdfs:range ns10:DatasetAvailabilityType .

    ns10:datasetNoise a owl:DatatypeProperty ;
        rdfs:comment "Potentially noisy elements of the dataset."@en ;
        rdfs:range xsd:string .

