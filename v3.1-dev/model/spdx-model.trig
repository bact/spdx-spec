`PackageVerificationCode`."""@en ;
        rdfs:range xsd:string .

    ns8:postOfficeBoxNumber a owl:DatatypeProperty ;
        rdfs:comment "The number that identifies a PO box. A PO box is a box in a post office or other postal service location assigned to an organization where postal items may be kept."@en ;
        rdfs:range xsd:string .

    ns8:postalCode a owl:DatatypeProperty ;
        rdfs:comment "Text specifying the postal code for an address."@en ;
        rdfs:range xsd:string .

    ns8:postalName a owl:DatatypeProperty ;
        rdfs:comment "The name of the recipient expressed in text."@en ;
        rdfs:range xsd:string .

    ns8:prefix a owl:DatatypeProperty ;
        rdfs:comment "A substitute for a URI."@en ;
        rdfs:range xsd:string .

    ns8:processRationale a owl:DatatypeProperty ;
        rdfs:comment "The reason a process exists."@en ;
        rdfs:range xsd:string .

    ns8:processReadiness a owl:DatatypeProperty ;
        rdfs:comment "processReadiness describes the readiness of a process."@en ;
        rdfs:range ns8:ProcessReadinessType .

    ns8:processVersion a owl:DatatypeProperty ;
        rdfs:comment "Defines the version of a specific process."@en ;
        rdfs:range xsd:string .

    ns8:profileConformance a owl:ObjectProperty ;
        rdfs:comment """Describes one a profile which the creator of this ElementCollection intends to
conform to."""@en ;
        rdfs:range ns8:ProfileIdentifierType .

    ns8:provinceStateCode a owl:DatatypeProperty ;
        rdfs:comment "Text specifying a province or state."@en ;
        rdfs:range xsd:string .

    ns8:quantity a owl:DatatypeProperty ;
        rdfs:comment "Quantity is the amount in the selected QUDT unit."@en ;
        rdfs:range xsd:string .

    ns8:relationshipType a owl:ObjectProperty ;
        rdfs:comment "Information about the relationship between two Elements."@en ;
        rdfs:range ns8:RelationshipType .

    ns8:releaseTime a owl:DatatypeProperty ;
        rdfs:comment "Specifies the time an artifact was released."@en ;
        rdfs:range xsd:dateTimeStamp .

    ns8:requirementRationale a owl:DatatypeProperty ;
        rdfs:comment "Text used to define the rationale or additional information."@en ;
        rdfs:range xsd:string .

    ns8:requirementStatement a owl:DatatypeProperty ;
        rdfs:comment "A text describing the actual need defined by the requirement."@en ;
        rdfs:range xsd:string .

    ns8:requirementUUID a owl:DatatypeProperty ;
        rdfs:comment "Provides a universally unique Requirement ID."@en ;
        rdfs:range ns8:ExternalIdentifier .

