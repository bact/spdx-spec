    ns4:typeFromSource a owl:DatatypeProperty ;
        rdfs:comment "typeFromSource is a value used to define an item within the definitionSource."@en ;
        rdfs:range xsd:string .

    ns4:unitQUDT a owl:DatatypeProperty ;
