            sh:NodeShape ;
        rdfs:comment "A Package that contains a dataset."@en ;
        rdfs:subClassOf ns5:Package ;
        sh:nodeKind sh:IRI ;
        sh:property _:N011184e99f2448ebb2bb8f2dfe73da08,
