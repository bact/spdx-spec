        rdfs:comment "A license exception that is listed on the SPDX Exceptions list."@en ;
        rdfs:subClassOf ns4:LicenseAddition ;
        sh:nodeKind sh:IRI ;
        sh:property _:N3705f0f2373043e689282da4d834bf7d,
            _:Nc1b31266b1114b6688c15053aab937ff .

    ns4:OrLaterOperator a owl:Class,
            sh:NodeShape ;
        rdfs:comment """Portion of an AnyLicenseInfo representing this version, or any later version,
