        rdfs:subClassOf ns6:CreateProcess ;
        sh:nodeKind sh:IRI .

    ns6:OutOfSpecAction a owl:Class ;
        rdfs:comment "An out of specification action is defined in this class."@en ;
        rdfs:subClassOf ns6:UseAction ;
        sh:nodeKind sh:IRI .

    ns6:PlanAction a owl:Class ;
        rdfs:comment "A PlanAction involves the execution of a plan in relation to a PlanProcess."@en ;
        rdfs:subClassOf ns6:UseAction ;
        sh:nodeKind sh:IRI .

    ns6:PlanProcess a owl:Class ;
