        sh:nodeKind sh:IRI ;
        sh:property _:N303fc3649f1e4480b94aea7597cc8bdb,
            _:N56188378e53f419394c8565397bb4057,
            _:N7995e7ed2e874f3c9bc87a1e587acd9d,
