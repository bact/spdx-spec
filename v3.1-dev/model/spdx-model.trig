    ns10:VexUnderInvestigationVulnAssessmentRelationship a owl:Class ;
        rdfs:comment """Designates elements as products where the impact of a vulnerability is being
investigated."""@en ;
        rdfs:subClassOf ns10:VexVulnAssessmentRelationship ;
        sh:nodeKind sh:IRI .

    ns10:Vulnerability a owl:Class,
            sh:NodeShape ;
        rdfs:comment "Specifies a vulnerability and its associated information."@en ;
