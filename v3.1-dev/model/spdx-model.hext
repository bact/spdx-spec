["_:Ne54792789ddd455ba63bf52aefa01ac3", "http://www.w3.org/ns/shacl#select", "BASE <https://spdx.org/rdf/3/terms/>\nSELECT $this WHERE {\n    $this <Core/relationshipType> <Core/RelationshipType/hasUninstall> .\n    FILTER NOT EXISTS { $this rdf:type <Core/LifecycleScopedRelationship> }\n}", "http://www.w3.org/2001/XMLSchema#string", "", ""]
["_:N9d5cc98a4c184cf2bd9f3f143e4107f9", "http://www.w3.org/1999/02/22-rdf-syntax-ns#first", "https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/iswc", "globalId", "", ""]
["https://spdx.org/rdf/3/terms/Security/SsvcDecisionType/act", "http://www.w3.org/2000/01/rdf-schema#comment", "The vulnerability requires attention from the organization's internal, supervisory-level and leadership-level individuals. Necessary actions include requesting assistance or information about the vulnerability, as well as publishing a notification either internally and/or externally. Typically, internal groups would meet to determine the overall response and then execute agreed upon actions. CISA recommends remediating Act vulnerabilities as soon as possible.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/Core/ProcessReadinessType/obsoleted", "http://www.w3.org/2000/01/rdf-schema#label", "obsoleted", "http://www.w3.org/2001/XMLSchema#string", "", ""]
["_:Nab937a403dc84860b886f7a397d9b678", "http://www.w3.org/ns/shacl#select", "BASE <https://spdx.org/rdf/3/terms/>\nSELECT $this WHERE {\n    $this <Core/relationshipType> <Core/RelationshipType/providesSupportFor> .\n    $this <Core/to> ?to .\n    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* <Core/Artifact> }\n}", "http://www.w3.org/2001/XMLSchema#string", "", ""]
["_:Nb7582f8d1f414f308f0efb363c48b3c6", "http://www.w3.org/ns/shacl#not", "_:N55ec019531b5458694c6e893087150e7", "localId", "", ""]
