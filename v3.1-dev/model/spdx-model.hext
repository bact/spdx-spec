["https://spdx.org/rdf/3.1/terms/Core/RelationshipType/hasSpecification", "http://www.w3.org/1999/02/22-rdf-syntax-ns#type", "https://spdx.org/rdf/3.1/terms/Core/RelationshipType", "globalId", "", ""]
