# https://spdx.org/rdf/3.1/terms/Core/RelationshipType/hasContactPoint node1754
node1754 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>hasContactPoint</B></td></tr><tr><td href='https://spdx.org/rdf/3.1/terms/Core/RelationshipType/hasContactPoint' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3.1/terms/Core/RelationshipType/hasContactPoint</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;The `from` Artifact has each `to` Agent as a contact point. The use of `hasContactPoint` type is constrained to `ContactPointRelationship` typed relationships. The type of contact (i.e. security) may be specified using a `ContactPointRelationship` element.&quot;@en</td></tr></table> > ] 
