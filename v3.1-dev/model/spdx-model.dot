node381 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>assessment</B></td></tr><tr><td href='https://spdx.org/rdf/3.1/terms/FunctionalSafety/VerificationType/assessment' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3.1/terms/FunctionalSafety/VerificationType/assessment</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;A systematic examination of a system, process, or outcome to evaluate compliance of specific work products with a specific expectation with a specification, regulation or standard. Often involves judgement and a rationale of this judgement.&quot;@en</td></tr></table> > ] 
