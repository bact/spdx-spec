node919 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Nf15efbdc12054d33b214bb78a7a6ed6e</B></td></tr><tr><td href='Nf15efbdc12054d33b214bb78a7a6ed6e' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Nf15efbdc12054d33b214bb78a7a6ed6e</font></td></tr></table> > ] 
