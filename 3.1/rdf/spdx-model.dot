node949 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Build</B></td></tr><tr><td href='https://spdx.org/rdf/3.1/terms/Build/Build' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3.1/terms/Build/Build</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;Class that describes a build instance of software/artifacts.&quot;@en</td></tr></table> > ] 
