            sh:NodeShape ;
        rdfs:comment "A prescribed change to a product's location."@en ;
        rdfs:subClassOf ns9:ModifyProcess ;
        sh:nodeKind sh:IRI ;
        sh:property _:N8efa246b541b4a34a53ccd99cb321f93,
