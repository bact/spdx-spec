            sh:NodeShape ;
        rdfs:comment "Specifies a data package and its associated information."@en ;
        rdfs:subClassOf ns7:Package ;
        sh:nodeKind sh:IRI ;
        sh:property _:N0296c2f016ef4f9c98be88aa3ba90af3,
