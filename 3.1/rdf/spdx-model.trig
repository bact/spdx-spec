        rdfs:range <https://spdx.org/rdf/3.1/terms/Extension/Extension> .

    ns2:hashValue a owl:DatatypeProperty ;
        rdfs:comment "The result of applying a hash algorithm to an Element."@en ;
        rdfs:range xsd:string .

