    ns11:VexUnderInvestigationVulnAssessmentRelationship a owl:Class ;
        rdfs:comment """Designates elements as products where the impact of a vulnerability is being
investigated."""@en ;
        rdfs:subClassOf ns11:VexVulnAssessmentRelationship ;
        sh:nodeKind sh:IRI .

    ns11:Vulnerability a owl:Class,
            sh:NodeShape ;
