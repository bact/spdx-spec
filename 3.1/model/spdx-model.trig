    <https://spdx.org/rdf/3.1/terms/Core/SpecificationType/other> a owl:NamedIndividual,
            ns5:SpecificationType ;
        rdfs:label "other" ;
        rdfs:comment "Any specification that does not fall under any of the other entries."@en .

