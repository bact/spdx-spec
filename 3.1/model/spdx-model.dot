node286 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Nb960a51204d144698818215b7f7e309f</B></td></tr><tr><td href='Nb960a51204d144698818215b7f7e309f' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Nb960a51204d144698818215b7f7e309f</font></td></tr></table> > ] 
