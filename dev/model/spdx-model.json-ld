      {
        "@language": "en",
        "@value": "LEX Identifier is a Uniform Resource Name (URN) for sources of law within the [LEX namespace](https://www.iana.org/assignments/urn-formal/lex), as defined in [RFC 9676](https://datatracker.ietf.org/doc/rfc9676/) (e.g., `urn:lex:it:stato:decreto.legislativo:2018-08-10;101`)."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "lexid"
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3.1/terms/Core/ExternalIdentifierType/verificationUUID",
