# N49cd4b7b2fc94c93b01ce070627d1bfe node399
node399 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N49cd4b7b2fc94c93b01ce070627d1bfe</B></td></tr><tr><td href='N49cd4b7b2fc94c93b01ce070627d1bfe' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N49cd4b7b2fc94c93b01ce070627d1bfe</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is providesSupportFor, to must be an Artifact&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
