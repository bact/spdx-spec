node0 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>crl</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/Service/KeyValidationProtocolType/crl' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/Service/KeyValidationProtocolType/crl</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;Certificate Revocation List, or CRL, is a list of revoked certificates as defined in [RFC 5280]](https://datatracker.ietf.org/doc/rfc5280/) that is downloaded from the Certificate Authority (CA).&quot;@en</td></tr></table> > ] 
# https://spdx.org/rdf/3/terms/Core/Relationship node1
node1 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Relationship</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/Core/Relationship' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/Core/Relationship</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;Describes a relationship between one or more elements.&quot;@en</td></tr></table> > ] 
# N3f9b7cb9b09047b8a1de0a2e39c8f3f8 node2
node2 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N3f9b7cb9b09047b8a1de0a2e39c8f3f8</B></td></tr><tr><td href='N3f9b7cb9b09047b8a1de0a2e39c8f3f8' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N3f9b7cb9b09047b8a1de0a2e39c8f3f8</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is assumes, to must be an Assumption&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/assumes&gt; .
    $this &lt;Core/to&gt; ?to .
    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* &lt;FunctionalSafety/Assumption&gt; }
}&quot;</td></tr></table> > ] 
