# N33f1a50bdb524b6db7ca68031d069ee9 node1789
node1789 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N33f1a50bdb524b6db7ca68031d069ee9</B></td></tr><tr><td href='N33f1a50bdb524b6db7ca68031d069ee9' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N33f1a50bdb524b6db7ca68031d069ee9</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is hasAssociatedVulnerability, to must be a Vulnerability&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/hasAssociatedVulnerability&gt; .
    $this &lt;Core/to&gt; ?to .
    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* &lt;Security/Vulnerability&gt; }
}&quot;</td></tr></table> > ] 
