# https://spdx.org/rdf/3/terms/Software/ContentIdentifierType/swhid node838
node838 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>swhid</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/Software/ContentIdentifierType/swhid' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/Software/ContentIdentifierType/swhid</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;SoftWare Hash IDentifier, a persistent intrinsic identifier for digital artifacts, such as files, trees (also known as directories or folders), commits, and other objects typically found in version control systems. The format of the identifiers is defined in the [SWHID specification](https://www.swhid.org/swhid-specification/v1.2/) ([ISO/IEC 18670](https://www.iso.org/standard/89985.html)). They typically look like `swh:1:cnt:94a9ed024d3859793618152ea559a168bbcbb5e2`.&quot;@en</td></tr></table> > ] 
# Nd4bcdaa816e94a629c881d2c0ad5234d node839
node839 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Nd4bcdaa816e94a629c881d2c0ad5234d</B></td></tr><tr><td href='Nd4bcdaa816e94a629c881d2c0ad5234d' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Nd4bcdaa816e94a629c881d2c0ad5234d</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is createdBy, from must be an Action or DefinedProcess&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
