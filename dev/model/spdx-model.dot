# N927f113d8c6947de9cf06ef3cb2b25ad node1275
node1275 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N927f113d8c6947de9cf06ef3cb2b25ad</B></td></tr><tr><td href='N927f113d8c6947de9cf06ef3cb2b25ad' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N927f113d8c6947de9cf06ef3cb2b25ad</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is underInvestigationFor, from must be a Vulnerability&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/underInvestigationFor&gt; .
    $this &lt;Core/from&gt; ?from .
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* &lt;Security/Vulnerability&gt; }
}&quot;</td></tr></table> > ] 
