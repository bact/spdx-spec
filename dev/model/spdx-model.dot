# N3fcfdbdf1c714406963c684c945627d5 node1176
node1176 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N3fcfdbdf1c714406963c684c945627d5</B></td></tr><tr><td href='N3fcfdbdf1c714406963c684c945627d5' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N3fcfdbdf1c714406963c684c945627d5</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is publishedBy, from must be a Vulnerability&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
