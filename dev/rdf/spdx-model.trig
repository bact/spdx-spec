        rdfs:range ns1:DictionaryEntry .

    ns8:currentResponsibleAgent a owl:ObjectProperty ;
        rdfs:comment "This is the individual, business, or organization who currently manages or responsible for the goods, services, or assets."@en ;
        rdfs:range ns1:Agent .

    ns8:currentState a owl:ObjectProperty ;
        rdfs:comment "This is the state of an affected Element."@en ;
