        rdfs:range xsd:anyURI .

    ns9:lineRange a owl:DatatypeProperty ;
        rdfs:comment """Defines the line range in the original host file that the snippet information
applies to."""@en ;
        rdfs:range ns3:PositiveIntegerRange .

