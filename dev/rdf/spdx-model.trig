    ns9:packageVersion a owl:DatatypeProperty ;
        rdfs:comment "Identify the version of a package."@en ;
        rdfs:range xsd:string .

    ns9:primaryPurpose a owl:ObjectProperty ;
        rdfs:comment "Provides information about the primary purpose of the software artifact."@en ;
        rdfs:range ns9:SoftwarePurpose .

    ns9:sbomType a owl:ObjectProperty ;
