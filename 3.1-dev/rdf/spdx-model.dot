node960 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Nf581d09adb0045d9b46ab8ef67ed87a3</B></td></tr><tr><td href='Nf581d09adb0045d9b46ab8ef67ed87a3' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Nf581d09adb0045d9b46ab8ef67ed87a3</font></td></tr></table> > ] 
