        sh:nodeKind sh:IRI ;
        sh:property _:Nd49be37871d74dc5b93ba72f90b28d3a,
            _:Ne49d188a2c74499e85ff547076ab47ed,
            _:Nf70ec8a4b29948e2bc3b3b5c09712e5b .

