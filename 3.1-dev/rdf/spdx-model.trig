        sh:nodeKind sh:IRI ;
        sh:property _:Nc59890557d6f4864a46a16b7de62d374 .

    ns10:InstantiateVirtualHardwareProcess a owl:Class ;
        rdfs:comment "Class that describes an InstantiateVirtualHardwareProcess that is used to define VirtualHardware and its source."@en ;
        rdfs:subClassOf ns10:CreateProcess ;
        sh:nodeKind sh:IRI .

    ns10:ManufactureAction a owl:Class ;
        rdfs:comment "ManufactureAction represents the act of creating a product by a manufacturing process."@en ;
        rdfs:subClassOf ns10:CreateAction ;
        sh:nodeKind sh:IRI .

    ns10:ManufactureProcess a owl:Class ;
