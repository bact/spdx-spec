        rdfs:subClassOf ns10:CreateProcess ;
        sh:nodeKind sh:IRI .

    ns10:ResolutionAction a owl:Class ;
        rdfs:comment "Products out of specification require a resolution action. This is the action of resolution."@en ;
        rdfs:subClassOf ns10:UseAction ;
        sh:nodeKind sh:IRI .

    ns10:ResponsibilityChangeAction a owl:Class,
