        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:property _:N0eff96e69ce24c53ab93a225802e729b,
            _:N40a3eb10157345278b226a55ca0ef3e4,
            _:Nb5606252c5e2463b9f8d322d2f83f46e .

    ns2:Person a owl:Class ;
        rdfs:comment "An individual human being."@en ;
        rdfs:subClassOf ns2:Agent ;
        sh:nodeKind sh:IRI .

