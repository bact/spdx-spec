    <https://spdx.org/rdf/3.1/terms/Core/HashAlgorithm/md2> a owl:NamedIndividual,
            ns2:HashAlgorithm ;
        rdfs:label "md2" ;
        rdfs:comment "MD2 message-digest algorithm, as defined in [RFC 1319](https://datatracker.ietf.org/doc/rfc1319/)."@en .

