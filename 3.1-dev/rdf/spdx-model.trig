    <https://spdx.org/rdf/3.1/terms/Security/CvssSeverityType/none> a owl:NamedIndividual,
            ns5:CvssSeverityType ;
        rdfs:label "none" ;
        rdfs:comment "When a CVSS score is 0.0."@en .

