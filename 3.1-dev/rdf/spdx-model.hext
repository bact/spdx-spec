["https://spdx.org/rdf/3/terms/SupplyChain/BoundaryDefinitionAction", "http://www.w3.org/1999/02/22-rdf-syntax-ns#type", "http://www.w3.org/ns/shacl#NodeShape", "globalId", "", ""]
