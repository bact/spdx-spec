["_:N5cf15852ad604096b8a8ee315b821f14", "http://www.w3.org/ns/shacl#select", "BASE <https://spdx.org/rdf/3/terms/>\nSELECT $this WHERE {\n    $this <Core/relationshipType> <Core/RelationshipType/republishedBy> .\n    $this <Core/to> ?to .\n    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* <Core/Agent> }\n}", "http://www.w3.org/2001/XMLSchema#string", "", ""]
