    ns4:standardLicenseHeader a owl:DatatypeProperty ;
        rdfs:comment """Provides a License author's preferred text to indicate that a file is covered
by the License."""@en ;
        rdfs:range xsd:string .

    ns4:standardLicenseTemplate a owl:DatatypeProperty ;
