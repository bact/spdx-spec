        rdfs:comment "A license addition that is not listed on the SPDX Exceptions List."@en ;
        rdfs:subClassOf ns11:LicenseAddition ;
        sh:nodeKind sh:IRI .

    ns11:DisjunctiveLicenseSet a owl:Class,
            sh:NodeShape ;
