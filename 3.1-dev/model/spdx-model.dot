# N745d3b05b920493a8cbd11fe893f2032 node1852
node1852 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N745d3b05b920493a8cbd11fe893f2032</B></td></tr><tr><td href='N745d3b05b920493a8cbd11fe893f2032' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N745d3b05b920493a8cbd11fe893f2032</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is hasTest, class must be LifecycleScopedRelationship&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
