# N22209bc0ce094ebabdb6cce6c5cddd4a node813
node813 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N22209bc0ce094ebabdb6cce6c5cddd4a</B></td></tr><tr><td href='N22209bc0ce094ebabdb6cce6c5cddd4a' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N22209bc0ce094ebabdb6cce6c5cddd4a</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is verifiedBy, from must be a Requirement&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/verifiedBy&gt; .
    $this &lt;Core/from&gt; ?from .
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* &lt;Core/Requirement&gt; }
}&quot;</td></tr></table> > ] 
