node760 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N07316468be164941a98da6a1a5ef5f59</B></td></tr><tr><td href='N07316468be164941a98da6a1a5ef5f59' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N07316468be164941a98da6a1a5ef5f59</font></td></tr><tr><td align='left'>sh:maxCount</td><td align='left'>&quot;1&quot;^^xsd:integer</td></tr><tr><td align='left'>sh:minCount</td><td align='left'>&quot;1&quot;^^xsd:integer</td></tr></table> > ] 
