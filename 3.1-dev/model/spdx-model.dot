# Nea758279fb3943b0a73d90359e45d80f node368
node368 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Nea758279fb3943b0a73d90359e45d80f</B></td></tr><tr><td href='Nea758279fb3943b0a73d90359e45d80f' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Nea758279fb3943b0a73d90359e45d80f</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is hasProvidedDependency, class must be LifecycleScopedRelationship&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/hasProvidedDependency&gt; .
    FILTER NOT EXISTS { $this rdf:type &lt;Core/LifecycleScopedRelationship&gt; }
}&quot;</td></tr></table> > ] 
