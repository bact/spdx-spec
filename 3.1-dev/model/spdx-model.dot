# Nd91baaa6523142fd9b22592bb0b95df5 node1146
node1146 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Nd91baaa6523142fd9b22592bb0b95df5</B></td></tr><tr><td href='Nd91baaa6523142fd9b22592bb0b95df5' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Nd91baaa6523142fd9b22592bb0b95df5</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is hasUninstall, class must be LifecycleScopedRelationship&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
