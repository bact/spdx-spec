# Nf88868708272408286e9aca74603967d node1266
node1266 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Nf88868708272408286e9aca74603967d</B></td></tr><tr><td href='Nf88868708272408286e9aca74603967d' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Nf88868708272408286e9aca74603967d</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is doesNotAffect, class must be VexNotAffectedVulnAssessmentRelationship&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
