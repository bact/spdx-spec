# N6e73e839f2ac471ebe28d43420dcd6ae node1421
node1421 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N6e73e839f2ac471ebe28d43420dcd6ae</B></td></tr><tr><td href='N6e73e839f2ac471ebe28d43420dcd6ae' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N6e73e839f2ac471ebe28d43420dcd6ae</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship id dependsOn, class must be LifecycleScopedRelationship&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/dependsOn&gt; .
    FILTER NOT EXISTS { $this rdf:type &lt;Core/LifecycleScopedRelationship&gt; }
